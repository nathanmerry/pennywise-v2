DATABASE_URL="postgresql://pennywise:pennywise@localhost:5435/pennywise_db"

TRUELAYER_CLIENT_ID="your-client-id"
TRUELAYER_CLIENT_SECRET="your-client-secret"
TRUELAYER_REDIRECT_URI="http://localhost:3001/api/connections/callback"

# Use sandbox for development
TRUELAYER_AUTH_URL="https://auth.truelayer-sandbox.com"
