    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "cleanup:old-categories": "tsx scripts/cleanup-old-categories.ts",
    "cleanup:posted-duplicates": "tsx scripts/remove-posted-duplicates.ts",
    "test": "node --import tsx --import ./test/setup.cjs --test test/*.test.ts",
    "notifications:daily": "node dist/scripts/send-daily-notifications.js",
