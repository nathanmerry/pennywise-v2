# Base URL of your running Pennywise backend API (the Express server).
PENNYWISE_API_URL=http://localhost:3382

# Shared secret every MCP client must present (Authorization: Bearer <token>
# or ?token=<token>). Generate a strong one, e.g.:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Port this MCP bridge listens on.
MCP_PORT=3391
