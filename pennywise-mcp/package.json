{
  "name": "pennywise-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP bridge exposing Pennywise spending data to ChatGPT (and other MCP clients).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
